{
  "name": "Infra Agent – telecom site permit check",
  "nodes": [
    {
      "id": "e814fdf8-7068-41b0-b6f3-67fe3e23a8f6",
      "name": "New site request",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        0,
        300
      ],
      "webhookId": "6d03b45b-1d3d-4597-89ee-3feadcb1de18",
      "parameters": {
        "formTitle": "New mobile site – permit check",
        "formDescription": "Infra Agent checks the planned site against BEMFV § 4 and 26. BImSchV and drafts a permit-readiness memo. Every requirement is cited to the law.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Site name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Address",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Latitude",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Longitude",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Mounting",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "rooftop"
                  },
                  {
                    "option": "freestanding mast"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Antenna height above ground (m)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "EIRP of the new installation (W)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "EIRP already installed at this site (W)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Lowest frequency used (MHz)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Municipality consulted on site selection?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "yes"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Site plan (Lageplan) ready?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "yes"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Building drawing with dimensions ready?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "yes"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Antenna diagrams ready?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "yes"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "buttonLabel": "Check site"
        }
      }
    },
    {
      "id": "94e942d9-f44e-4ede-ab46-1237c95ec9cd",
      "name": "Map form to API inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Form labels -> API field names (one place to change if the form changes)\nconst f = $input.first().json;\nconst yes = v => String(v).toLowerCase().startsWith('y');\nreturn [{ json: { inputs: {\n  site_name: f['Site name'],\n  address: f['Address'],\n  lat: f['Latitude'],\n  lon: f['Longitude'],\n  mount: f['Mounting'],\n  antenna_height_m: f['Antenna height above ground (m)'],\n  new_eirp_w: f['EIRP of the new installation (W)'],\n  existing_eirp_w: f['EIRP already installed at this site (W)'],\n  frequency_mhz: f['Lowest frequency used (MHz)'],\n  municipality_consulted: yes(f['Municipality consulted on site selection?']),\n  site_plan: yes(f['Site plan (Lageplan) ready?']),\n  building_drawing: yes(f['Building drawing with dimensions ready?']),\n  antenna_diagrams: yes(f['Antenna diagrams ready?']),\n} } }];"
      }
    },
    {
      "id": "a1c193d2-f81b-4cbf-b371-d9a3cd851d90",
      "name": "Check site (rules + citations)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
