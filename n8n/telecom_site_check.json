      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/packs/telecom_permit/assess",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: $json.inputs }) }}",
        "options": {}
      }
    },
